#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -eq 0 ]]; then
  echo "Run this installer as the Codespace user, not root."
  exit 1
fi

if ! command -v apt-get >/dev/null 2>&1; then
  echo "This installer requires a Debian/Ubuntu based Codespace image."
  exit 1
fi

CLOUD_DIR="$HOME/.cloud-desktop"
mkdir -p "$CLOUD_DIR"

echo
echo "============================================================"
echo " Cloud Linux Desktop V3"
echo " XFCE + SSH + xRDP + Cloudflare Tunnel"
echo "============================================================"
echo

read -r -p "Linux desktop username [desktop]: " DESKTOP_USER
DESKTOP_USER="${DESKTOP_USER:-desktop}"

read -r -s -p "Linux desktop password: " DESKTOP_PASS
echo

read -r -p "SSH hostname (example: ssh.example.com): " SSH_HOST
read -r -p "RDP hostname (example: rdp.example.com): " RDP_HOST

if [[ -z "$DESKTOP_PASS" || -z "$SSH_HOST" || -z "$RDP_HOST" ]]; then
  echo "Password, SSH hostname, and RDP hostname are required."
  exit 1
fi

echo
echo "[1/7] Installing desktop, SSH and xRDP packages..."
sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
  xfce4 xfce4-goodies \
  dbus-x11 dbus-user-session xauth x11-xserver-utils \
  policykit-1 sudo curl wget ca-certificates \
  openssh-server xrdp

echo
echo "[2/7] Creating desktop user..."
if id "$DESKTOP_USER" >/dev/null 2>&1; then
  echo "User $DESKTOP_USER already exists."
else
  sudo useradd -m -s /bin/bash "$DESKTOP_USER"
fi

echo "$DESKTOP_USER:$DESKTOP_PASS" | sudo chpasswd
sudo usermod -aG sudo "$DESKTOP_USER" || true
sudo usermod -aG ssl-cert "$DESKTOP_USER" || true

sudo -u "$DESKTOP_USER" bash -c 'cat > "$HOME/.xsession" <<EOF
#!/bin/sh
export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce
exec dbus-launch --exit-with-session startxfce4
EOF
chmod +x "$HOME/.xsession"'

echo
echo "[3/7] Configuring SSH..."
sudo mkdir -p /run/sshd
sudo ssh-keygen -A >/dev/null 2>&1 || true

if sudo grep -qE '^[#[:space:]]*ListenAddress[[:space:]]+' /etc/ssh/sshd_config; then
  sudo sed -i -E 's/^[#[:space:]]*ListenAddress[[:space:]].*/ListenAddress 127.0.0.1/' /etc/ssh/sshd_config
else
  echo 'ListenAddress 127.0.0.1' | sudo tee -a /etc/ssh/sshd_config >/dev/null
fi

sudo sed -i -E 's/^[#[:space:]]*PasswordAuthentication[[:space:]]+.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
if ! sudo grep -qE '^PasswordAuthentication[[:space:]]+yes' /etc/ssh/sshd_config; then
  echo 'PasswordAuthentication yes' | sudo tee -a /etc/ssh/sshd_config >/dev/null
fi

echo
echo "[4/7] Configuring xRDP..."
sudo mkdir -p /etc/xrdp
sudo sed -i -E 's/^[#[:space:]]*port=.*/port=127.0.0.1:3389/' /etc/xrdp/xrdp.ini || true

sudo tee /etc/xrdp/startwm.sh >/dev/null <<'EOF'
#!/bin/sh
unset DBUS_SESSION_BUS_ADDRESS
unset XDG_RUNTIME_DIR
exec dbus-launch --exit-with-session startxfce4
EOF
sudo chmod +x /etc/xrdp/startwm.sh

echo
echo "[5/7] Installing cloudflared..."
if ! command -v cloudflared >/dev/null 2>&1; then
  curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg \
    | sudo gpg --dearmor -o /usr/share/keyrings/cloudflare-main.gpg

  echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' \
    | sudo tee /etc/apt/sources.list.d/cloudflared.list >/dev/null

  sudo apt-get update
  sudo apt-get install -y cloudflared
fi

echo
echo "[6/7] Writing runtime configuration..."
cat > "$CLOUD_DIR/config.env" <<EOF
SSH_HOST=$(printf '%q' "$SSH_HOST")
RDP_HOST=$(printf '%q' "$RDP_HOST")
DESKTOP_USER=$(printf '%q' "$DESKTOP_USER")
EOF
chmod 600 "$CLOUD_DIR/config.env"

cat > "$CLOUD_DIR/start-desktop.sh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

CLOUD_DIR="$HOME/.cloud-desktop"
CONFIG="$CLOUD_DIR/config.env"
PIDFILE="$CLOUD_DIR/runtime.pid"

[[ -f "$CONFIG" ]] && source "$CONFIG"

: "${SSH_HOST:?SSH_HOST missing}"
: "${RDP_HOST:?RDP_HOST missing}"
: "${DESKTOP_USER:?DESKTOP_USER missing}"
: "${CF_TUNNEL_TOKEN:?CF_TUNNEL_TOKEN environment secret is required}"

mkdir -p "$CLOUD_DIR"

cleanup() {
  rm -f "$PIDFILE"
}
trap cleanup EXIT INT TERM

# SSH: localhost only.
if ! pgrep -x sshd >/dev/null 2>&1; then
  sudo /usr/sbin/sshd
fi

# xRDP: localhost only.
if ! pgrep -x xrdp-sesman >/dev/null 2>&1; then
  sudo /usr/sbin/xrdp-sesman
fi

if ! pgrep -x xrdp >/dev/null 2>&1; then
  sudo /usr/sbin/xrdp
fi

# Cloudflare connector.
if ! pgrep -af 'cloudflared.*tunnel.*--token' >/dev/null 2>&1; then
  nohup cloudflared tunnel --no-autoupdate run --token "$CF_TUNNEL_TOKEN" \
    >>"$CLOUD_DIR/cloudflared.log" 2>&1 &
fi

echo "$$" > "$PIDFILE"

echo "============================================================"
echo " Cloud Linux Desktop is running"
echo " SSH : $SSH_HOST"
echo " RDP : $RDP_HOST"
echo "============================================================"

# Activity loop. This keeps terminal I/O active, but does NOT
# bypass the Codespaces maximum lifetime.
while true; do
  printf '[codespace-keepalive] %s | ssh=%s | rdp=%s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" \
    "$SSH_HOST" \
    "$RDP_HOST"
  sleep 5m
done
EOF
chmod +x "$CLOUD_DIR/start-desktop.sh"

echo
echo "[7/7] Testing configuration..."
if command -v cloudflared >/dev/null 2>&1; then
  cloudflared --version || true
fi

echo
echo "============================================================"
echo " Installation complete"
echo "============================================================"
echo
echo "IMPORTANT:"
echo "1. Create a GitHub Codespaces Secret named:"
echo "     CF_TUNNEL_TOKEN"
echo "2. Put your Cloudflare Tunnel token in that secret."
echo "3. Make sure the Cloudflare Tunnel routes are configured:"
echo "     $SSH_HOST -> ssh://localhost:22"
echo "     $RDP_HOST -> rdp://localhost:3389"
echo "4. Restart/rebuild the Codespace."
echo
echo "After that, .devcontainer/start.sh will automatically start:"
echo "  - SSH"
echo "  - xRDP"
echo "  - Cloudflare Tunnel"
echo "  - keepalive loop"
echo
echo "Runtime log:"
echo "  $CLOUD_DIR/runtime.log"
echo
echo "Cloudflare log:"
echo "  $CLOUD_DIR/cloudflared.log"
echo
echo "The tunnel token is NOT written to the repository or config.env."
echo
